{
    "image_size": [
        224,
        224
    ],
    "batch_size": 32,
    "seed": 42,
    "classes": [
        "cardboard",
        "glass",
        "metal",
        "paper",
        "plastic",
        "trash"
    ],
    "class_mapping": {
        "cardboard": 0,
        "glass": 1,
        "metal": 2,
        "paper": 3,
        "plastic": 4,
        "trash": 5
    },
    "split_ratios": {
        "training": 0.7,
        "validation": 0.15,
        "testing": 0.15
    },
    "normalization": "pixel_values_divided_by_255",
    "augmentation": [
        "horizontal_flip",
        "rotation",
        "zoom",
        "contrast"
    ],
    "class_balancing": "balanced_class_weights"
}